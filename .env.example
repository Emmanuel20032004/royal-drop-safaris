# Copy to .env.production and point at your hosted API before running `npm run build`.
# Leave unset for local development (defaults to http://localhost:3000).
VITE_API_BASE=https://your-domain.co.ke/api

# Optional shared secret. If ADMIN_API_KEY is set in api/config.php, the same
# value must be provided here so /auth/login can be reached by the admin app.
# Leave blank if you disabled it server-side.
VITE_ADMIN_KEY=
