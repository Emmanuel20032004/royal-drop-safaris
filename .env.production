# Production build settings — points the app at the live Hostinger API.
# Uses the index.php path form because the .htaccess rewrite is not active on the server.
VITE_API_BASE=https://royaldropsafaris.com/api/index.php

# Optional shared secret. If ADMIN_API_KEY is set in api/config.php, the same
# value must be provided here so /auth/login can be reached by the admin app.
# Leave blank if you disabled it server-side.
VITE_ADMIN_KEY=
